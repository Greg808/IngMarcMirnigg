---
import BaseLayout from "@layouts/BaseLayout.astro";
import { company } from "@content/company";
import { placeholders } from "@content/placeholders";
---

<BaseLayout
  title={`AGB - ${company.name}`}
  description={`Allgemeine Geschäftsbedingungen von ${company.name}.`}
  canonicalPath="/agb/"
>
  <section class="legal-page" aria-labelledby="terms-title">
    <p class="eyebrow">Optional</p>
    <h1 id="terms-title">AGB</h1>
    <p class="placeholder-note">{placeholders.legalNotice}</p>
    <p>
      Platzhalter: Laut PRD sind AGB optional. Vor Veröffentlichung muss
      entschieden werden, ob diese Seite benötigt wird und welcher geprüfte Text
      verwendet werden soll.
    </p>
  </section>
</BaseLayout>
