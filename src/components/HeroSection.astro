---
import CtaLink from "@components/CtaLink.astro";
import { company } from "@content/company";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content">
    <p class="eyebrow">Familiengeführter Güterverkehr</p>
    <h1 id="hero-title">
      Transporte für Gewerbekunden in Wien und Niederösterreich.
    </h1>
    <p class="hero__lead">
      {company.name} steht für persönliche Betreuung, flexible Termine und
      verlässliche Abwicklung im nationalen Güterverkehr.
    </p>
    <div class="hero__actions" aria-label="Kontaktmöglichkeiten">
      <CtaLink href={company.phone.href}>Anrufen</CtaLink>
      <CtaLink href={company.email.href} variant="secondary">E-Mail schreiben</CtaLink>
    </div>
  </div>
</section>
