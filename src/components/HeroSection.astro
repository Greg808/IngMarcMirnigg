---
import CtaLink from "@components/CtaLink.astro";
import { company } from "@content/company";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content">
    <p class="eyebrow">Familiengeführtes Transportunternehmen</p>
    <h1 id="hero-title">
      Güterverkehr für Gewerbekunden in Wien und Niederösterreich
    </h1>
    <p class="hero__lead">
      {company.name} übernimmt gewerbliche Transporte mit persönlicher
      Betreuung, flexibler Terminabstimmung und verlässlicher Abwicklung. Das
      Kerngebiet liegt in Wien und Niederösterreich.
    </p>
    <div class="hero__actions" aria-label="Kontaktmöglichkeiten">
      <CtaLink href={company.phone.href}>Anrufen</CtaLink>
      <CtaLink href={company.email.href} variant="secondary">E-Mail schreiben</CtaLink>
    </div>
  </div>
</section>
