---
import { customerPriorities } from "@content/customerPriorities";
---

<section
  class="section customer-priorities"
  aria-labelledby="customer-priorities-title"
>
  <div class="section__header section__header--wide">
    <p class="eyebrow">Worauf Gewerbekunden Wert legen</p>
    <h2 id="customer-priorities-title">
      Gute Transporte beginnen mit klarer Kommunikation
    </h2>
    <p>
      Bei gewerblichen Transportaufträgen zählen nicht nur Fahrzeuge und
      Termine. Entscheidend ist, dass Zuständigkeiten klar sind, Änderungen
      rasch besprochen werden können und die Abwicklung verlässlich bleibt.
    </p>
  </div>

  <div class="customer-priorities__grid">
    {
      customerPriorities.map((item) => (
        <article class="customer-priority">
          <p class="customer-priority__label">{item.label}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))
    }
  </div>
</section>
