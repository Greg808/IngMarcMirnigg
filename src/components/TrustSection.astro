---
import { company } from "@content/company";

const trustItems = [
  `${company.experience} im gewerblichen Transport`,
  "Familienunternehmen in zweiter Generation",
  "persönliche Betreuung durch den Unternehmer",
  "schnelle Reaktion bei kurzfristigem Bedarf",
  "zuverlässige und diskrete Abwicklung",
  "moderne Euro-6-Fahrzeuge",
  "sachlicher Einsatz von HVO-Kraftstoff",
  "faire und nachvollziehbare Zusammenarbeit",
];
---

<section class="section trust" id="warum-mirnigg" aria-labelledby="trust-title">
  <div class="section__header section__header--wide">
    <p class="eyebrow">Warum Mirnigg</p>
    <h2 id="trust-title">
      Ein direkter Ansprechpartner statt anonymer Abwicklung
    </h2>
    <p>
      Mirnigg Transporte ist ein familiengeführtes Unternehmen in zweiter
      Generation. Gewerbekunden profitieren von kurzen Wegen, persönlicher
      Abstimmung und mehr als 25 Jahren Erfahrung im Güterverkehr.
    </p>
  </div>

  <div class="trust__body">
    <ul class="trust-list" aria-label="Vertrauensmerkmale">
      {
        trustItems.map((item) => (
          <li>
            <span aria-hidden="true"></span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
