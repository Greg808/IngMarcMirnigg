---
import ThemeToggle from "@components/ThemeToggle.astro";
import { company } from "@content/company";

type NavigationItem = {
  label: string;
  href: string;
};

type Props = {
  navigation: NavigationItem[];
};

const { navigation } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${company.name} Startseite`}>
      <img src="/images/mirnigg-logo.svg" alt="" width="96" height="96" />
      <span>{company.name}</span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      {
        navigation.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Navigation öffnen">
        <span aria-hidden="true"></span>
      </summary>
      <nav class="mobile-nav__menu" aria-label="Mobile Hauptnavigation">
        {
          navigation.map((item) => (
            <a href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>

    <ThemeToggle />
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".mobile-nav").forEach((menu) => {
    menu.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    });
  });
</script>
