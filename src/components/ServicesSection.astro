---
import { services } from "@content/services";
---

<section class="section section--soft" id="leistungen" aria-labelledby="leistungen-title">
  <div class="section__header section__header--wide">
    <p class="eyebrow">Leistungen</p>
    <h2 id="leistungen-title">
      Transporte für planbare Touren und kurzfristigen Bedarf
    </h2>
    <p>
      Ob Komplettladung, Teilladung, Expresszustellung oder Vertretungsfahrt:
      Mirnigg Transporte unterstützt Unternehmen, wenn Güter zuverlässig,
      direkt und klar abgestimmt transportiert werden müssen.
    </p>
  </div>

  <div class="service-grid">
    {
      services.map((service) => (
        <article class="service-item">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </article>
      ))
    }
  </div>
</section>
