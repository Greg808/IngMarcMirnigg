---
import { services } from "@content/services";
---

<section class="section section--soft" id="leistungen" aria-labelledby="leistungen-title">
  <div class="section__header section__header--wide">
    <p class="eyebrow">Leistungen</p>
    <h2 id="leistungen-title">Für planbare Touren und kurzfristigen Bedarf.</h2>
    <p>
      Die Leistungen sind bewusst verständlich beschrieben, damit Gewerbekunden
      schnell erkennen, ob ihr Transport grundsätzlich abgedeckt wird.
    </p>
  </div>

  <div class="service-grid">
    {
      services.map((service) => (
        <article class="service-item">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </article>
      ))
    }
  </div>
</section>
